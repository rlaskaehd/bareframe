#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/env"
cd "$BAREFRAME_ROOT"
# The everyday development bundle has its own name and id, so it is never mistaken for an
# installed release.
bundle_name=bareframe-dev
profile=debug
bundles="$CARGO_TARGET_DIR"
case "${1:-}" in
    --validation)
        bundle_name=bareframe-validation
        mkdir -p target/validation
        ;;
    # An optimized build to hand to others, kept apart from the everyday bundle so a
    # running copy of that one is never overwritten underneath itself.
    --release)
        profile=release
        bundle_name=bareframe
        bundles="$CARGO_TARGET_DIR/dist"
        ;;
esac
if [[ "$profile" == release ]]; then
    cargo build --locked --release
else
    cargo build --locked
fi
bundle_dir="$bundles/$bundle_name.app/Contents"
mkdir -p "$bundle_dir/MacOS" "$bundle_dir/Resources"
# Shell integration (GPLv3) that the app finds at ../Resources/shell-integration/zsh.
integration="$bundle_dir/Resources/shell-integration"
rm -rf "$integration"
mkdir -p "$integration/zsh"
cp vendor/gpui-libghostty/crates/gpui-ghostty/vendor/ghostty/src/shell-integration/zsh/.zshenv \
    vendor/gpui-libghostty/crates/gpui-ghostty/vendor/ghostty/src/shell-integration/zsh/ghostty-integration \
    "$integration/zsh/"
cp resources/shell-integration/README resources/shell-integration/COPYING "$integration/"
mkdir -p "$integration/bareframe"
cp resources/shell-integration/bareframe/.zshenv "$integration/bareframe/"
cp "$CARGO_TARGET_DIR/$profile/bareframe" "$bundle_dir/MacOS/bareframe"
# What agents in terminals run to reach the browser tabs (see src/browser/control.rs).
cp "$CARGO_TARGET_DIR/$profile/bareframe-browser" "$bundle_dir/MacOS/bareframe-browser"
# What is handed out carries its license and every built-in component's.
if [[ "$profile" == release ]]; then
    cp LICENSE "$bundle_dir/Resources/LICENSE"
    "$CARGO_TARGET_DIR/release/bareframe-release" notices "$bundle_dir/Resources/THIRD_PARTY_NOTICES.txt"
fi
# The updater compares this with the release tag, so it follows Cargo.toml.
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
# macOS ends an app that reaches for Bluetooth, the camera or the microphone without saying
# why in its usage descriptions. Chromium does: passkeys on a phone (sign-in pages), calls.
cat > "$bundle_dir/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>dev.bareframe.app</string>
<key>CFBundleName</key><string>bareframe</string>
<key>CFBundleDisplayName</key><string>bareframe</string>
<key>CFBundleExecutable</key><string>bareframe</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$version</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSBluetoothAlwaysUsageDescription</key><string>Web pages use Bluetooth to sign in with a passkey on your phone.</string>
<key>NSCameraUsageDescription</key><string>Web pages you allow can use the camera.</string>
<key>NSMicrophoneUsageDescription</key><string>Web pages you allow can use the microphone.</string>
</dict></plist>
PLIST
# The icon is drawn from the brand artwork, which stays out of the repository; without it
# the bundle simply has no icon.
icon_source=docs/brand/icon/bareframe-icon-1024.png
if [[ -f "$icon_source" ]]; then
    iconset="$CARGO_TARGET_DIR/AppIcon.iconset"
    rm -rf "$iconset"
    mkdir -p "$iconset"
    for size in 16 32 128 256 512; do
        sips -z "$size" "$size" "$icon_source" --out "$iconset/icon_${size}x${size}.png" >/dev/null
        sips -z $((size * 2)) $((size * 2)) "$icon_source" \
            --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    iconutil -c icns "$iconset" -o "$bundle_dir/Resources/AppIcon.icns"
    /usr/libexec/PlistBuddy -c 'Add :CFBundleIconFile string AppIcon' "$bundle_dir/Info.plist"
fi
if [[ "$bundle_name" == bareframe-dev ]]; then
    /usr/libexec/PlistBuddy -c 'Set :CFBundleIdentifier dev.bareframe.dev' \
        -c 'Set :CFBundleName bareframe-dev' \
        -c 'Set :CFBundleDisplayName bareframe dev' "$bundle_dir/Info.plist"
fi
if [[ "$bundle_name" == bareframe-validation ]]; then
    /usr/libexec/PlistBuddy -c 'Set :CFBundleIdentifier dev.bareframe.validation' \
        -c 'Set :CFBundleName bareframe-validation' \
        -c 'Set :CFBundleDisplayName bareframe validation' \
        -c 'Add :LSEnvironment dict' \
        -c 'Add :LSEnvironment:BAREFRAME_VALIDATION string 1' "$bundle_dir/Info.plist"
fi
# Chromium for browser panes: CEF's framework, and the helper apps it starts its renderer,
# GPU and other processes from, each a copy of bareframe-helper under the name CEF expects.
frameworks="$bundle_dir/Frameworks"
framework="Chromium Embedded Framework.framework"
mkdir -p "$frameworks"
# The framework is large and fixed for a CEF version, so it is copied again only when the
# distribution in CEF_PATH changes.
copied="$bundles/.$bundle_name-cef-archive.json"
if [[ ! -d "$frameworks/$framework" ]] || ! cmp -s "$CEF_PATH/archive.json" "$copied"; then
    rm -rf "$frameworks/$framework"
    ditto "$CEF_PATH/$framework" "$frameworks/$framework"
    cp "$CEF_PATH/archive.json" "$copied"
fi
if [[ "$profile" == release ]]; then
    cp "$CEF_PATH/CREDITS.html" "$bundle_dir/Resources/CHROMIUM_CREDITS.html"
fi
bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$bundle_dir/Info.plist")
for kind in "" " (GPU)" " (Renderer)" " (Plugin)" " (Alerts)"; do
    name="bareframe Helper$kind"
    helper="$frameworks/$name.app/Contents"
    mkdir -p "$helper/MacOS"
    cp "$CARGO_TARGET_DIR/$profile/bareframe-helper" "$helper/MacOS/$name"
    suffix=$(printf '%s' "$kind" | tr -d '() ' | tr '[:upper:]' '[:lower:]')
    cat > "$helper/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>$bundle_id.helper${suffix:+.$suffix}</string>
<key>CFBundleName</key><string>$name</string>
<key>CFBundleExecutable</key><string>$name</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$version</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>LSUIElement</key><string>1</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
done
# script/release names its own certificate; everything else is signed ad hoc. The helpers
# and the framework inside are signed with the app.
codesign --force --deep --sign "${BAREFRAME_SIGN_IDENTITY:--}" "$bundles/$bundle_name.app"
echo "$bundles/$bundle_name.app"
