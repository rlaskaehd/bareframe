#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/env"
cd "$BAREFRAME_ROOT"
./script/bootstrap --update-lockfile
mkdir -p .cache/downloads .tools/src target/validation
if [[ ! -x .tools/htop/bin/htop ]]; then
    curl --fail --location --retry 2 \
        https://github.com/htop-dev/htop/releases/download/3.5.3/htop-3.5.3.tar.xz \
        --output .cache/downloads/htop-3.5.3.tar.xz
    curl --fail --location --retry 2 \
        https://github.com/htop-dev/htop/releases/download/3.5.3/htop-3.5.3.tar.xz.sha256 \
        --output .cache/downloads/htop-3.5.3.tar.xz.sha256
    (cd .cache/downloads && shasum -a 256 --check htop-3.5.3.tar.xz.sha256)
    tar -xJf .cache/downloads/htop-3.5.3.tar.xz -C .tools/src
    (cd .tools/src/htop-3.5.3 && ./configure --prefix="$BAREFRAME_ROOT/.tools/htop" && make -j2 && make install)
fi
# Fixture dependencies are local to the project, not installed into the claude env.
mamba run -n claude python -m pip install --upgrade --target "$BAREFRAME_ROOT/.tools/ssh-fixture" \
    -r "$BAREFRAME_ROOT/requirements.txt"
nohup mamba run -n claude python "$BAREFRAME_ROOT/tests/ssh_fixture.py" \
    > "$BAREFRAME_ROOT/target/validation/ssh-fixture.log" 2>&1 < /dev/null &
echo "Validation tools prepared. The one-connection SSH fixture listens only on 127.0.0.1 and expires after 10 minutes."
